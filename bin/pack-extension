#!/usr/bin/env bash
# pack-extension — produce a Chrome-loadable copy of an MV3 extension dir.
#
# Chrome refuses to load an unpacked extension whose tree contains any file or
# directory starting with "_" ("reserved for use by the system"). This repo's
# convention of co-locating tests in __tests__/ therefore makes extension
# checkouts unloadable as-is. This script copies the extension into <dir>/dist
# with test dirs, _metadata, and other non-runtime files stripped.
#
# Usage: pack-extension <extension-dir>
#   then load <extension-dir>/dist in chrome://extensions (Developer mode).
#
# dist/ is a generated artifact: it is git- and prettier-ignored per
# .gitignore / .prettierignore — do not commit it.

set -euo pipefail

SRC="${1:-}"
if [[ -z "$SRC" || ! -f "$SRC/manifest.json" ]]; then
    echo "Usage: pack-extension <extension-dir>" >&2
    echo "(<extension-dir> must contain manifest.json)" >&2
    exit 1
fi

DST="$SRC/dist"

if ! command -v rsync >/dev/null 2>&1; then
    echo "pack-extension: rsync is required" >&2
    exit 1
fi

rsync -a --delete \
    --exclude '__tests__' \
    --exclude 'tests' \
    --exclude '_metadata' \
    --exclude 'dist' \
    --exclude '.DS_Store' \
    "$SRC/" "$DST/"

# Fail loudly if anything underscore-prefixed still slipped through — Chrome
# would reject the load with a confusing error otherwise. Allowed exceptions:
# _locales (i18n, part of the source) and _metadata (Chrome writes this into
# the loaded unpacked directory itself, so it reappears in dist after loading).
leftovers=$(find "$DST" -path '*/_metadata' -prune -o -name '_*' ! -name '_locales' -print -quit)
if [[ -n "$leftovers" ]]; then
    echo "pack-extension: '_' -prefixed entry remains: $leftovers" >&2
    echo "add an --exclude rule for it in $0" >&2
    exit 1
fi

echo "packed: $DST"
echo "load this directory in chrome://extensions (Developer mode -> Load unpacked)"
