# Containerized precommit environment for net-tools.
# Use via `make precommit-docker` on hosts where privileged tests fail locally
# (e.g. macOS socket permissions). Mirrors the CI runner (ubuntu-latest).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Node comes from NodeSource 22.x, not Ubuntu's `nodejs` package: Ubuntu 24.04
# ships Node 18, but the pinned dependency-cruiser 18.x needs `util.styleText`
# (Node >= 20.12) and its dependency tree requires ^22.13 || ^24 || >=26.
RUN for i in 1 2 3; do \
        apt-get update && break; \
        echo "apt-get update failed, retrying in 5s..."; \
        sleep 5; \
    done \
    && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    make \
    libcurl4-openssl-dev \
    curl \
    ca-certificates \
    git \
    python3 \
    python3-pip \
    python3-venv \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dev deps before copying full source for layer caching.
COPY requirements-dev.txt ./
RUN pip install --break-system-packages -r requirements-dev.txt

# Install Node deps before copying full source for layer caching.
COPY package.json package-lock.json ./
RUN npm ci

# Copy full source and run the precommit gate by default. C binaries are cleaned
# first so that host-architecture artifacts bind-mounted into the container are
# rebuilt as Linux binaries before the tests try to execute them. `.claude/commands/`
# is also regenerated first so the sync-check gate passes without relying on the
# host's ability to write that directory.
COPY . .
CMD ["sh", "-c", "make -C nas_tools clean && make -C nas_proxy clean && python3 tools/sync_commands.py && make precommit"]
