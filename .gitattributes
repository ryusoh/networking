# Handle line endings automatically for text files
* text=auto

# Text files
*.md text eol=lf
*.tex text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.java text eol=lf
*.json text eol=lf
*.p4 text eol=lf
*.p4info text eol=lf

# Binary files - prevent text diffing and corruption
*.pdf binary
*.pcap binary
*.pcapng binary
*.gns3 binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.eps binary
*.zip binary
*.tar.gz binary
