{
  "manifest_version": 3,
  "name": "Stall Guard",
  "version": "0.1.0",
  "description": "Auto-recover from HTML5 video stalls: when playback freezes mid-stream, seek back a few seconds and resume instead of waiting for the network.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.criterionchannel.com/*", "*://player.vimeo.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
