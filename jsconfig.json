{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2021",
    "module": "node16",
    "lib": ["dom", "dom.iterable", "es2021"],
    "types": ["chrome"],
    "skipLibCheck": true
  },
  "include": ["adblock/*.js", "gov_bypass/*.js", "stall_guard/*.js"],
  "exclude": ["node_modules", "adblock/__tests__", "stall_guard/dist", "gov_bypass/__tests__"]
}
