{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2021",
    "module": "node16",
    "lib": ["dom", "dom.iterable", "es2021"],
    "types": ["chrome"],
    "skipLibCheck": true
  },
  "include": [
    "adblock/*.js",
    "gov_bypass/tianditu-defaults.js",
    "gov_bypass/offscreen.js",
    "gov_bypass/background.js",
    "gov_bypass/tile-cache-page.js",
    "stall_guard/*.js"
  ],
  "exclude": ["node_modules", "adblock/__tests__", "stall_guard/dist"]
}
